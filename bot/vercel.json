{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": { "maxDuration": 120 }
  },
  "crons": [
    { "path": "/api/cron/minuto", "schedule": "* * * * *" },
    { "path": "/api/cron/inventario", "schedule": "*/10 * * * *" }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ."
}
